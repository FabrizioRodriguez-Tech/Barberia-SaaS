generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id         String     @id @default(uuid())
  nombre     String
  creadoEn   DateTime   @default(now())
  sucursales Sucursal[]
  servicios  Servicio[]
}

model Sucursal {
  id        String  @id @default(uuid())
  nombre    String
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

model Servicio {
  id          String  @id @default(uuid())
  nombre      String
  duracionMin Int
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)
  empresaId   String
  empresa     Empresa @relation(fields: [empresaId], references: [id])
}
