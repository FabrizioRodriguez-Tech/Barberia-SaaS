generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id         String     @id @default(uuid())
  nombre     String
  creadoEn   DateTime   @default(now())
  sucursales Sucursal[]
}

model Sucursal {
  id        String  @id @default(uuid())
  nombre    String
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}
